<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1A0505">

    <TextView
        android:id="@+id/text_title_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O DILEMA DE CASMURRO"
        android:textColor="#A88B60"
        android:textSize="12sp"
        android:letterSpacing="0.4"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moeda Capitolina"
        android:textColor="#D4AF37"
        android:textSize="32sp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:layout_marginBottom="48dp" />

    <ImageView
        android:id="@+id/coin_image"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/moeda_cara"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/result_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="sans-serif-light"
        android:text="TOQUE PARA LANÇAR A SORTE"
        android:textColor="#E0E0E0"
        android:textSize="16sp"
        android:letterSpacing="0.1"
        android:textAlignment="center" />

    <TextView
        android:id="@+id/quote_text"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:textAlignment="center"
        android:textColor="#A88B60"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:alpha="0" />

    <TextView
        android:id="@+id/btn_sobre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="SOBRE O APP"
        android:textColor="#A88B60"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>